# SQLite (mais fácil para rodar local) ou MySQL
DB_DSN=sqlite:database/chamados.sqlite
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=chamados;charset=utf8mb4
DB_USER=
DB_PASSWORD=

# mínimo de 32 caracteres; gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_TTL_MINUTES=480

# feriados que param o relógio do SLA (AAAA-MM-DD, separados por vírgula)
SLA_HOLIDAYS=2026-10-12,2026-11-02,2026-11-15,2026-11-20,2026-12-25
CORS_ORIGIN=*
